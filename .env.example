# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e preencha os valores.   cp .env.example .env
# O `.env` é ignorado pelo git (nunca é commitado).
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados (OBRIGATÓRIO) ─────────────────────────────────────────────
# String de conexão PostgreSQL. No Supabase:
#   Project Settings → Database → Connection string → URI
# Troque [PASSWORD] pela senha do projeto.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.SEU_PROJETO.supabase.co:5432/postgres"

# ── API de futebol (OBRIGATÓRIO para popular o banco via seed.js) ─────────────
# Chave da API-Football (api-sports.io). Crie em https://dashboard.api-football.com
API_KEY="sua_chave_api_football"
URL="https://v3.football.api-sports.io"

# ── Ollama (opcional — geração de análise tática local) ──────────────────────
# Usado pelo botão "Gerar com Ollama" e pela pré-geração (--provider ollama).
# Em produção (Vercel) não há Ollama; o app serve as análises do cache.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ── Anthropic / Claude (opcional — pré-geração com --provider claude) ─────────
# Só é necessário se rodar `npm run generate-analyses -- --provider claude`.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"

# ── Servidor local (opcional) ────────────────────────────────────────────────
# PORT="3000"

# ── Seed (opcional) ──────────────────────────────────────────────────────────
# Liga padrão a popular quando não passar --league. 71 = Brasileirão Série A.
# Outras: 39 Premier, 140 La Liga, 135 Serie A, 78 Bundesliga, 61 Ligue 1.
# LEAGUE_ID="71"
